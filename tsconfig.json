{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src", "migrations", "seeds", "scripts"],
  // The Workers entry and its Cloudflare-only app are checked by tsconfig.worker.json.
  "exclude": ["src/worker.ts", "src/cf", "src/types.d.ts"]
}
