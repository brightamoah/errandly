{
  "name": "errandly",
  "version": "1.0.0",
  "description": "Personal shopping and delivery: Node/Express/PostgreSQL API with React interface",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:web": "pnpm --prefix web run dev",
    "build": "tsc -p . && pnpm --prefix web run build",
    "build:web": "pnpm --prefix web run build",
    "start": "node dist/src/server.js",
    "db": "tsx scripts/db.ts",
    "db:prod": "node dist/scripts/db.js",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.worker.json",
    "cf:dev": "wrangler dev",
    "cf:typecheck": "tsc --noEmit -p tsconfig.worker.json",
    "cf:dry-run": "wrangler deploy --dry-run --outdir=.wrangler/dry-run",
    "cf:deploy": "pnpm run build:web && wrangler deploy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "morgan": "^1.12.1",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wrangler": "^4.157.0"
  },
  "engines": {
    "node": ">=20"
  }
}
