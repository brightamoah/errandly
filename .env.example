# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/errands
# Used by `npm test`; must be a separate database because tests truncate it.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/errands_test
# Long random string. Required in production. Generate: openssl rand -hex 32
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h
# Service fee in minor units (1500 = GHS 15.00), stored on each order at submission
SERVICE_FEE_MINOR=1500
CURRENCY=GHS
# Set true for hosted Postgres that requires SSL (Render, Railway, Neon...)
DATABASE_SSL=false
# Run migrations automatically when the server starts
MIGRATE_ON_START=false
# Allow `npm run db:prod -- seed` in a production-mode demo environment
ALLOW_SEED=false
