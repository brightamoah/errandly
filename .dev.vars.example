# Local-only secrets for `pnpm run cf:dev` (wrangler dev). Never commit this file.

# Required: signs access tokens in the Worker.
JWT_SECRET=dev-only-secret-change-me

# Where `wrangler dev` sends Postgres traffic. Hyperdrive itself only exists in
# production, so locally Wrangler connects straight to this database.
# Neon: the pooled or direct URL both work here.
# The Hyperdrive connection string is provided by the binding at runtime.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgres://postgres:postgres@localhost:5432/errands
